<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ADR-005 §5: the foreground service that owns the active turn. POST_NOTIFICATIONS is declared
         for API 33+ devices even though targetSdk 28 means it is granted at install; the notification
         itself is posted by the service, never by the activity. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- extractNativeLibs=true (equivalent): declared in build.gradle.kts as
         packaging.jniLibs.useLegacyPackaging = true, because AGP 9 rejects the manifest attribute
         outright (issue #149770867). Currently a no-op: the shipped userland (bundled GNU bash,
         ADR-006) exec's from app data (ADR-001 / ENVIRONMENT.md), not from the native library dir. -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketHarness"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PocketHarness">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ADR-005 §5: owns the active turn so it survives backgrounding. Not exported, not bound;
             it exists only to hold the process foreground-important while a turn runs. -->
        <service
            android:name=".TurnService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
